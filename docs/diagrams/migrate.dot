digraph migrate_doc {
  rankdir=TB; fontname="Helvetica"; labelloc=t;
  label="migrate.dot — documentation view (derived; the executable graph is pipelines/migrate.dot)";
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=10, color="#546e7a"];
  start [shape=Mdiamond, style=filled, fillcolor="#c8e6c9"];
  CheckBacklog [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  SelectStory [shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  BranchSetup [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  StudySource [shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  PlanPort [shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  Implement [shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  UnitValidate [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  ForgeValidate [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  AnalyzeFailure [shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  RetryGate [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  Commit [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  MarkBlocked [shape=parallelogram, style=filled, fillcolor="#fff9c4"];
  exit [shape=Msquare, style=filled, fillcolor="#ffcdd2"];
  CheckBacklog -> exit [label="blocked"];
  RetryGate -> exit [label="blocked"];
  Commit -> exit [label="blocked"];
  MarkBlocked -> exit [label="blocked"];
  UnitValidate -> exit [label="blocked"];
  ForgeValidate -> exit [label="blocked"];
  start -> CheckBacklog;
  CheckBacklog -> exit [label="done"];
  CheckBacklog -> SelectStory [label="process"];
  SelectStory -> BranchSetup;
  BranchSetup -> StudySource [label="ready"];
  BranchSetup -> exit [label="blocked"];
  StudySource -> PlanPort;
  PlanPort -> Implement;
  Implement -> UnitValidate;
  UnitValidate -> ForgeValidate [label="pass"];
  UnitValidate -> AnalyzeFailure [label="fail"];
  ForgeValidate -> Commit [label="pass"];
  ForgeValidate -> AnalyzeFailure [label="fail"];
  AnalyzeFailure -> RetryGate;
  RetryGate -> Implement [label="retry"];
  RetryGate -> MarkBlocked [label="giveup"];
  Commit -> CheckBacklog [label="next"];
  MarkBlocked -> CheckBacklog [label="next"];
  subgraph cluster_legend {
    label="legend"; fontsize=10; style=dashed; color="#90a4ae";
    l1 [shape=box, style="rounded,filled", fillcolor="#bbdefb", label="LLM agent node"];
    l2 [shape=parallelogram, style=filled, fillcolor="#fff9c4", label="deterministic gate/tool\n(routes on last stdout line)"];
    l1 -> l2 [label="edge label = routing value", style=invis];
  }
}

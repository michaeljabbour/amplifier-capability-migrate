// GM — Loop 1: BLIND VERIFICATION (outer loop; runs after migrate loops land stories).
//
// For each backlog story in state `implemented`, a verifier BLIND to every builder
// artifact independently derives acceptance from the SOURCE app (the executable
// ground truth) and validates the TARGET. Pass -> terminal state `verified`.
// Fail -> findings; the ledger reopens ONCE (implemented -> new). Rebuilding an
// existing gm/<story> branch stops for manual ownership/recovery confirmation;
// this graph never resets, reuses or renames a pre-existing branch automatically.
//
// WHY: the migrate loop authors the tests + probe it must pass, and its fix loop
// could amend story cards (self-grading + mutable rubric). This loop is the
// independent rubric-writer: it never reads story cards, builder tests, or .ai/gm_*.
// It may READ the row's story-id + title only. Verifier -> builder info flow is
// allowed (.ai/verify_findings/); builder -> verifier is forbidden. Story-card
// amendment proposals (.ai/gm_amendment_proposals/) are accepted only here or by a
// human — never by the migrate loop itself.
//
// ENGINE: attractor loop-pipeline (same contract as migrate.dot).
//   SOURCE_PATH  abs path to the source app (ground truth; read+observe only)
//   TARGET_PATH  abs path to the migrated app under verification
//   TARGET_KIND  python | rust | new:<lang> (how to run the target, informational)
//   FORGE_TOOL   abs path to amplifier-skill-forge/tools/forge.py
//   LEDGER_TOOL  abs path to this bundle's pipelines/ledger.py
//   BACKLOG      abs path to the sequenced backlog TSV
//
// MODELS: claude-opus-4-8 on LLM nodes.

digraph gm_verify {
    graph [
        goal="Loop 1 — blind verification. For each backlog story in state 'implemented', independently confirm the TARGET exhibits the SOURCE app's behavior for that story. Derive your own checks by observing the SOURCE (executable ground truth), knowing only the story id + title slug. NEVER read story cards (inventory/stories/), builder artifacts (.ai/gm_*), or the target's tests — independence is the point. Pass -> 'verified' (terminal). Fail -> findings, reopen once (-> new), then 'acknowledged'. Never edit source or target code.",
        default_fidelity="truncate",
        default_max_retry="3"
    ]

    start [shape=Mdiamond]

    CheckQueue [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; story(){ case \"$STORY\" in ''|.|..|*[!A-Za-z0-9._-]*) die 'invalid STORY';; esac; }; safe_dir(){ test ! -L \"$1\" || die 'symlinked verifier directory'; if test -e \"$1\"; then test -d \"$1\" || die 'verifier directory is not a directory'; fi; }; safe_file(){ test ! -L \"$1\" || die 'symlinked verifier file'; if test -e \"$1\"; then test -f \"$1\" || die 'verifier file is not regular'; fi; }; root \"${TARGET_PATH:?set TARGET_PATH}\"; cd -- \"$TARGET_PATH\" || exit 1; safe_dir .ai; : \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\" || exit 1; safe_file \"$BACKLOG\"; test -f \"$BACKLOG\" && test -r \"$BACKLOG\" || die 'missing or unreadable backlog'; : \"${SOURCE_PATH:?set SOURCE_PATH}\" \"${FORGE_TOOL:?set FORGE_TOOL}\" || exit 1; next=$(LEDGER_FILE=\"$BACKLOG\" python3 \"$LEDGER_TOOL\" earliest-implemented) || exit 1; if test \"$next\" = NONE; then printf done; else test \"$(printf '%s\\n' \"$next\" | wc -l | tr -d ' ')\" = 1 || die 'multiple queue rows'; STORY=${next%% *}; TITLE=${next#* }; test \"$STORY\" != \"$next\" && test -n \"$TITLE\" || die 'invalid queue row'; story; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_dir .ai/verify_logs; safe_file \".ai/verify_checks/$STORY.sh\"; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_logs/$STORY.log\"; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; printf process; fi ); then :; else printf blocked; fi"]

    SelectRow [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; story(){ case \"$STORY\" in ''|.|..|*[!A-Za-z0-9._-]*) die 'invalid STORY';; esac; }; safe_dir(){ test ! -L \"$1\" || die 'symlinked verifier directory'; if test -e \"$1\"; then test -d \"$1\" || die 'verifier directory is not a directory'; fi; }; safe_file(){ test ! -L \"$1\" || die 'symlinked verifier file'; if test -e \"$1\"; then test -f \"$1\" || die 'verifier file is not regular'; fi; }; root \"${TARGET_PATH:?set TARGET_PATH}\"; cd -- \"$TARGET_PATH\" || exit 1; safe_dir .ai; : \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\" || exit 1; safe_file \"$BACKLOG\"; test -f \"$BACKLOG\" && test -r \"$BACKLOG\" || die 'missing or unreadable backlog'; next=$(LEDGER_FILE=\"$BACKLOG\" python3 \"$LEDGER_TOOL\" earliest-implemented) || exit 1; test \"$next\" != NONE || die 'no implemented story'; test \"$(printf '%s\\n' \"$next\" | wc -l | tr -d ' ')\" = 1 || die 'multiple queue rows'; STORY=${next%% *}; TITLE=${next#* }; test \"$STORY\" != \"$next\" && test -n \"$TITLE\" || die 'invalid queue row'; story; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_dir .ai/verify_logs; safe_file \".ai/verify_checks/$STORY.sh\"; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_logs/$STORY.log\"; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_file .ai/verify_current.env; mkdir -p .ai/verify_checks .ai/verify_findings || exit 1; printf 'STORY=%s\\nTITLE=%s\\n' \"$STORY\" \"$TITLE\" > .ai/verify_current.env || exit 1; printf ready ); then :; else printf blocked; fi"]

    DeriveChecks [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="You are the BLIND VERIFIER. Read $TARGET_PATH/.ai/verify_current.env for STORY and TITLE — that title slug is ALL you may know about the story's intent. GROUND TRUTH ONLY: observe the SOURCE app at $SOURCE_PATH (read its code, RUN it — directly and/or via $FORGE_TOOL) to establish what behavior the title names: exact outputs, exit codes, edge cases. FORBIDDEN (your independence is the point): reading inventory/stories/ story cards, any .ai/gm_* builder artifact, or any tests in $TARGET_PATH. Then write $TARGET_PATH/.ai/verify_checks/$STORY.sh: a bash script that runs the REAL migrated app in $TARGET_PATH (directly and/or via $FORGE_TOOL, env $FORGE) for that behavior and asserts source-equivalence (outputs AND exit codes); exit 0 iff it holds. Observe the TARGET only through the terminal — do not read target implementation source (read code on the source side only). Write nothing outside .ai/verify_checks/. $goal"]

    RunChecks [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; story(){ case \"$STORY\" in ''|.|..|*[!A-Za-z0-9._-]*) die 'invalid STORY';; esac; }; safe_dir(){ test ! -L \"$1\" || die 'symlinked verifier directory'; if test -e \"$1\"; then test -d \"$1\" || die 'verifier directory is not a directory'; fi; }; safe_file(){ test ! -L \"$1\" || die 'symlinked verifier file'; if test -e \"$1\"; then test -f \"$1\" || die 'verifier file is not regular'; fi; }; root \"${TARGET_PATH:?set TARGET_PATH}\"; cd -- \"$TARGET_PATH\" || exit 1; safe_dir .ai; : \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\" || exit 1; safe_file \"$BACKLOG\"; test -f \"$BACKLOG\" && test -r \"$BACKLOG\" || die 'missing or unreadable backlog'; safe_file .ai/verify_current.env; STORY=; TITLE=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in STORY=*) test -z \"$STORY\" || die 'duplicate STORY'; STORY=${line#STORY=}; test -n \"$STORY\" || die 'empty STORY';; TITLE=*) test -z \"$TITLE\" || die 'duplicate TITLE'; TITLE=${line#TITLE=}; test -n \"$TITLE\" || die 'empty TITLE';; *) die 'invalid verifier state';; esac; done < .ai/verify_current.env || exit 1; story; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_dir .ai/verify_logs; safe_file \".ai/verify_checks/$STORY.sh\"; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_logs/$STORY.log\"; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; test -n \"$TITLE\" || die 'missing TITLE'; export STORY TITLE; safe_dir .ai/verify_checks; safe_file \".ai/verify_checks/$STORY.sh\"; test -f \".ai/verify_checks/$STORY.sh\" || die 'missing verification check'; safe_dir .ai/verify_logs; mkdir -p .ai/verify_logs || exit 1; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_logs/$STORY.log\"; export FORGE=\"${FORGE_TOOL:?set FORGE_TOOL}\"; test -f \"$FORGE\" || die 'missing Forge tool'; python3 \"$FORGE\" doctor >\".ai/verify_logs/$STORY-doctor.log\" 2>&1 || exit 1; if bash \".ai/verify_checks/$STORY.sh\" >\".ai/verify_logs/$STORY.log\" 2>&1; then printf pass; else printf fail; fi ); then :; else printf blocked; fi"]

    MarkVerified [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; story(){ case \"$STORY\" in ''|.|..|*[!A-Za-z0-9._-]*) die 'invalid STORY';; esac; }; safe_dir(){ test ! -L \"$1\" || die 'symlinked verifier directory'; if test -e \"$1\"; then test -d \"$1\" || die 'verifier directory is not a directory'; fi; }; safe_file(){ test ! -L \"$1\" || die 'symlinked verifier file'; if test -e \"$1\"; then test -f \"$1\" || die 'verifier file is not regular'; fi; }; root \"${TARGET_PATH:?set TARGET_PATH}\"; cd -- \"$TARGET_PATH\" || exit 1; safe_dir .ai; : \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\" || exit 1; safe_file \"$BACKLOG\"; test -f \"$BACKLOG\" && test -r \"$BACKLOG\" || die 'missing or unreadable backlog'; safe_file .ai/verify_current.env; STORY=; TITLE=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in STORY=*) test -z \"$STORY\" || die 'duplicate STORY'; STORY=${line#STORY=}; test -n \"$STORY\" || die 'empty STORY';; TITLE=*) test -z \"$TITLE\" || die 'duplicate TITLE'; TITLE=${line#TITLE=}; test -n \"$TITLE\" || die 'empty TITLE';; *) die 'invalid verifier state';; esac; done < .ai/verify_current.env || exit 1; story; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_dir .ai/verify_logs; safe_file \".ai/verify_checks/$STORY.sh\"; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_logs/$STORY.log\"; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; test -n \"$TITLE\" || die 'missing TITLE'; export STORY TITLE; LEDGER_FILE=\"$BACKLOG\" python3 \"$LEDGER_TOOL\" update \"$STORY\" verified >/dev/null || exit 1; printf next ); then :; else printf blocked; fi"]

    RecordFindings [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Your verification checks failed. Read $TARGET_PATH/.ai/verify_logs/$STORY.log, $TARGET_PATH/.ai/verify_logs/$STORY-doctor.log and your own script $TARGET_PATH/.ai/verify_checks/$STORY.sh (STORY from .ai/verify_current.env). Write $TARGET_PATH/.ai/verify_findings/$STORY.md: what the SOURCE does, what the TARGET does instead, and the exact failing assertion. FIRST LINE must be exactly FLAKE if the ONLY failure is a forge timing/screen-scrape artifact, otherwise exactly DEFECT. Do not edit code or your checks. $goal"]

    ReopenGate [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; story(){ case \"$STORY\" in ''|.|..|*[!A-Za-z0-9._-]*) die 'invalid STORY';; esac; }; safe_dir(){ test ! -L \"$1\" || die 'symlinked verifier directory'; if test -e \"$1\"; then test -d \"$1\" || die 'verifier directory is not a directory'; fi; }; safe_file(){ test ! -L \"$1\" || die 'symlinked verifier file'; if test -e \"$1\"; then test -f \"$1\" || die 'verifier file is not regular'; fi; }; root \"${TARGET_PATH:?set TARGET_PATH}\"; cd -- \"$TARGET_PATH\" || exit 1; safe_dir .ai; : \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\" || exit 1; safe_file \"$BACKLOG\"; test -f \"$BACKLOG\" && test -r \"$BACKLOG\" || die 'missing or unreadable backlog'; safe_file .ai/verify_current.env; STORY=; TITLE=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in STORY=*) test -z \"$STORY\" || die 'duplicate STORY'; STORY=${line#STORY=}; test -n \"$STORY\" || die 'empty STORY';; TITLE=*) test -z \"$TITLE\" || die 'duplicate TITLE'; TITLE=${line#TITLE=}; test -n \"$TITLE\" || die 'empty TITLE';; *) die 'invalid verifier state';; esac; done < .ai/verify_current.env || exit 1; story; safe_dir .ai/verify_checks; safe_dir .ai/verify_findings; safe_dir .ai/verify_logs; safe_file \".ai/verify_checks/$STORY.sh\"; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_logs/$STORY.log\"; safe_file \".ai/verify_logs/$STORY-doctor.log\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; test -n \"$TITLE\" || die 'missing TITLE'; export STORY TITLE; safe_dir .ai/verify_findings; safe_file \".ai/verify_findings/$STORY.md\"; safe_file \".ai/verify_flake_$STORY\"; safe_file \".ai/verify_reopened_$STORY\"; finding=$(head -1 \".ai/verify_findings/$STORY.md\") || exit 1; case \"$finding\" in FLAKE|DEFECT) :;; *) die 'invalid finding classification';; esac; if test \"$finding\" = FLAKE && ! test -f \".ai/verify_flake_$STORY\"; then touch \".ai/verify_flake_$STORY\" || exit 1; printf recheck; elif test -f \".ai/verify_reopened_$STORY\"; then LEDGER_FILE=\"$BACKLOG\" python3 \"$LEDGER_TOOL\" update \"$STORY\" acknowledged >/dev/null || exit 1; printf next; else touch \".ai/verify_reopened_$STORY\" || exit 1; if ! LEDGER_FILE=\"$BACKLOG\" python3 \"$LEDGER_TOOL\" update \"$STORY\" new >/dev/null; then rm -f \".ai/verify_reopened_$STORY\" || exit 1; exit 1; fi; printf next; fi ); then :; else printf blocked; fi"]

    exit [shape=Msquare]

    // A guard failure emits an explicit domain token: never route on a stale last_line.
    CheckQueue -> exit [condition="context.tool.last_line=blocked"]
    SelectRow -> exit [condition="context.tool.last_line=blocked"]
    RunChecks -> exit [condition="context.tool.last_line=blocked"]
    MarkVerified -> exit [condition="context.tool.last_line=blocked"]
    ReopenGate -> exit [condition="context.tool.last_line=blocked"]

    start -> CheckQueue
    CheckQueue -> exit      [condition="context.tool.last_line=done"]
    CheckQueue -> SelectRow [condition="context.tool.last_line=process"]
    SelectRow -> DeriveChecks [condition="context.tool.last_line=ready"]
    DeriveChecks -> RunChecks
    RunChecks -> MarkVerified   [condition="context.tool.last_line=pass"]
    RunChecks -> RecordFindings [condition="context.tool.last_line=fail"]
    RecordFindings -> ReopenGate
    ReopenGate -> RunChecks    [condition="context.tool.last_line=recheck"]
    ReopenGate -> CheckQueue   [condition="context.tool.last_line=next", loop_restart="true"]
    MarkVerified -> CheckQueue [condition="context.tool.last_line=next", loop_restart="true"]
}
